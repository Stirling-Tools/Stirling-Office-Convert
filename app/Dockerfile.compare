FROM eclipse-temurin:25-jre-noble@sha256:b4c93a50fc67612798db73d68ca3b0ee4ebdd51736e59cca370e689b9797037e AS office-fonts

# Free stand-ins for Office fonts (OFL, Apache, GPL or AGPL with font exception, GUST), all with TrueType outlines
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates python3-fonttools fonts-urw-base35 fonts-texgyre; \
    rm -rf /var/lib/apt/lists/*

COPY <<'EOF' /build/fonts.sha256
